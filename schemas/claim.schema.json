{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/claim.schema.json",
  "title": "Atomic legal claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "text", "module_id", "document_path", "anchor", "issue_tags", "jurisdiction", "court_level", "procedural_posture", "effective_date", "last_verified", "verification_status", "authority_ids", "classification", "known_limitations", "conflicting_authority_ids", "researcher_notes"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"},
    "text": {"type": "string", "minLength": 1},
    "module_id": {"type": "string", "pattern": "^MOD-[A-Z0-9-]+$"},
    "document_path": {"type": "string", "pattern": "^docs/"},
    "anchor": {"type": "string", "minLength": 1},
    "issue_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "jurisdiction": {"type": "string", "minLength": 1},
    "court_level": {"type": "string", "minLength": 1},
    "procedural_posture": {"type": "string", "minLength": 1},
    "effective_date": {"type": ["string", "null"]},
    "last_verified": {"type": "string", "format": "date"},
    "verification_status": {"enum": ["verified_current", "verified_historical", "partially_verified", "disputed", "superseded", "not_verified", "removed_from_legacy", "requires_citator_check"]},
    "authority_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AUTH-[A-Z0-9-]+$"}},
    "classification": {"enum": ["binding", "persuasive", "mixed", "historical", "not_applicable"]},
    "known_limitations": {"type": "string"},
    "conflicting_authority_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AUTH-[A-Z0-9-]+$"}},
    "researcher_notes": {"type": "string"}
  }
}
