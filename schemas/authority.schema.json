{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/authority.schema.json",
  "title": "Authority record",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority_id", "authority_type", "title", "citation", "issuing_body", "jurisdiction", "decision_or_issuance_date", "effective_date", "publication_status", "precedential_status", "subsequent_history", "negative_treatment_status", "official_url", "mirror_url", "local_snapshot_path", "sha256", "source_id", "verification_status", "citeable_propositions", "material_limitations", "quotations", "linked_claim_ids", "linked_module_ids", "last_verified"],
  "properties": {
    "authority_id": {"type": "string", "pattern": "^AUTH-[A-Z0-9-]+$"},
    "authority_type": {"enum": ["constitution", "statute", "rule", "regulation", "case", "guideline", "policy", "secondary"]},
    "title": {"type": "string", "minLength": 1},
    "citation": {"type": "string", "minLength": 1},
    "issuing_body": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "decision_or_issuance_date": {"type": ["string", "null"]},
    "effective_date": {"type": ["string", "null"]},
    "publication_status": {"type": "string", "minLength": 1},
    "precedential_status": {"type": "string", "minLength": 1},
    "subsequent_history": {"type": "string"},
    "negative_treatment_status": {"type": "string", "minLength": 1},
    "official_url": {"type": ["string", "null"], "format": "uri"},
    "mirror_url": {"type": ["string", "null"]},
    "local_snapshot_path": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"]},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "verification_status": {"enum": ["verified", "verified_with_limitations", "needs_update", "conflict", "unverified"]},
    "citeable_propositions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "material_limitations": {"type": "string"},
    "quotations": {"type": "array", "items": {"type": "string"}},
    "linked_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"}},
    "linked_module_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^MOD-[A-Z0-9-]+$"}},
    "last_verified": {"type": "string", "format": "date"}
  }
}
